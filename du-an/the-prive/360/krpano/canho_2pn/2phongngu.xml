	<!-- Back -->
	<layer name="flocontainer" type="container" enabled="true"
		bgcolor="0xFFFFFF" bgalpha="0.0" alpha="1" x="20" y="20"
		width="95" height="100" zorder="223"  bgcapture="true"
		align="topleft" keep="true" scalechildren="true" bgroundedge="5"

		x.mobile="5" y.mobile="5" height.mobile="88">

		<layer name="batdaudi" url="images/undo.png"  keep="true" align="topleft" scale="0.55"  scale.mobile="0.5"  x="60"
		y.mobile="16"
		align.mobile="topleft" css="display:none;" alpha="0.9"  onclick="js(selectScene(DEFAULT))" />

		<layer name="text_2pn" url="%SWFPATH%/plugins/textfield.swf" align="left" x="0" y="30"
		html="Căn hộ 2 Phòng ngủ" 
		css="
			font-weight:500; font-family:'Optima'; font-size:28px; color:#fff; padding:0;text-align:left; border-radius:10px; margin: 0;font-family: 'Montserrat', sans-serif;
		" 
		css.mobile="
			font-weight:500; font-family:'Optima';font-size:12px; color:#fff; padding:0;text-align:left; border-radius:10px; margin: 0;font-family: 'Montserrat', sans-serif;display:none;
		" 
		handcursor="true" enabled="false" background="false"
		y.mobile="0"   /> 
	</layer>

	<!-- Mobile floor plan -->
	<layer name="mini_map_mobile" devices="mobile" type="container" keep="true" bgcolor="0x000000" bgalpha="0.0" width="50" height="50" align="topright" x="5" y="5" >
		<layer name="icon_map" align="center" url="floor_plan/icon3.png" scale="0.5" state="turn_off" onclick="toggle_floor_plan()" />
	</layer>

	<action name="toggle_floor_plan">
		if(state == turn_off,
		set(layer[floorplan_container].visible,true);
		set(state,turn_on);
		,
		set(layer[floorplan_container].visible,false);
		set(state,turn_off);
		);
	</action>

	<action name="toggle_floor_plan">
		if(state == turn_off,
		set(layer[floorplan_container].visible,true);
		set(state,turn_on);
		,
		set(layer[floorplan_container].visible,false);
		set(state,turn_off);
		);
	</action>
<!-- action -->
	<events name="tourevents" keep="true" onxmlcomplete="setup_first_scene();" />

		<action name="setup_first_scene" scope="local">
			set(view, tx=get(image.ox), ty=get(image.oy), tz=get(image.oz));
			set(events[tourevents].onxmlcomplete, null);
			set(events[tourevents].onloadcomplete,
				set(events[tourevents].onloadcomplete, moveto_scene_center() );
			);
		</action>
		
		<action name="moveto_scene_center" scope="local">



		if (global.customtransition === null,
			tween(view.tx|view.ty|view.tz, calc(image.ox + '|' + image.oy + '|' + image.oz), 1.0, easeinoutsine);
		);


		if (global.customtransition == 'SKIP', 

		set(view.tx, calc(image.ox + 15 ));
			set(view.ty, get(image.oy));
			set(view.tz, calc(image.oz + 15 )); 

			set(view.tx, calc(image.ox + 0 ));
			set(view.ty, calc(image.oy + 0 ));
			set(view.tz, calc(image.oz + 0 ));

			tween(view.tx, get(image.ox));
			tween(view.ty, get(image.oy));
			tween(view.tz, get(image.oz));	
		);

		delete(global.customtransition);
	</action>


	<style name="br_spot" type="text" keep="true"
		css="font-size:20px;text-align:center;" vcenter="true"
		width="100" height="100" scale="10"
		bgroundedge="50" bgcolor="0xFFFFFF" bgborder="2 0x7FFFFFFF 1" 
		oversampling="2" mipmapping="true" zorder="1"
		distorted="true" depth="0" depthbuffer="true"
		torigin="world" rotationorder="xyz" rx="-90"
		alpha="0"
		onloaded.addevent="delayedcall(0.1, tween(alpha,0.5); );"
		onover.addevent="tween(alpha,0.7);"
		onout.addevent="tween(alpha,0.5);"

		onclick="tour_loadscene(get(linkedscene));"
		
		/>
	



	<action name="tour_loadscene" scope="local" args="scenename">
		loadscene(get(scenename), null, MERGE|KEEPVIEW|KEEPMOVING, BLEND(0.5));
	</action>
		





