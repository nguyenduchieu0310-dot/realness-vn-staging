  <action autorun="onstart" name="floor_hotspots" score="local">
	for(set(i,0), i LT style.count, inc(i),
	    copy(st, style[get(i)]);
	    subtxt(spotid,get(st.linkedscene),6,3);
	    addhotspot(get(tooltipname), hs);
	    hs.loadstyle(floorspot);
	    copy(hs.tx, st.ox);
