  <action name="toggleSoundIcon">
    tween(layer[ev_soundButton].alpha, 0.5, 0.2, default, tween(layer[ev_soundButton].alpha, 1.0, 0.2));
    
    if(sound_is_on,
      set(sound_is_on, false);
      set(layer[ev_soundButton].crop, "400|400|080|080");
      js(window.parent.postMessage('pause-audio', '*'));
    ,
      set(sound_is_on, true);
      set(layer[ev_soundButton].crop, "320|400|080|080");
